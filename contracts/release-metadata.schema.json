{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/contracts/release-metadata.schema.json",
  "title": "Release Metadata",
  "description": "Per-platform-target publish metadata for a project. Lives at projects/<id>/specs/release-metadata.json, keyed by the same target name used in release_package.py create --targets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "targets"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/target_metadata" }
    }
  },
  "$defs": {
    "target_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "hashtags",
        "alt_text",
        "language",
        "thumbnail_asset_id",
        "visibility"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "hashtags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "alt_text": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2, "maxLength": 10 },
        "thumbnail_asset_id": {
          "type": ["string", "null"],
          "pattern": "^ast_[a-z0-9]{12,32}$"
        },
        "visibility": { "enum": ["public", "unlisted", "private", "scheduled"] },
        "scheduled_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        {
          "description": "Scheduled visibility needs a scheduled_at timestamp.",
          "if": {
            "properties": { "visibility": { "const": "scheduled" } },
            "required": ["visibility"]
          },
          "then": {
            "required": ["scheduled_at"],
            "properties": { "scheduled_at": { "type": "string" } }
          }
        }
      ]
    }
  }
}
