{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/contracts/scene-layout.schema.json",
  "title": "Format adaptive scene layout",
  "description": "Editable, format-independent text layout. Coordinates and sizes are normalized to the target canvas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "elements"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/element"}
    }
  },
  "$defs": {
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "font_size": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_lines": {"type": "integer", "minimum": 1},
        "align": {"enum": ["left", "center", "right"]},
        "visible": {"type": "boolean"}
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content", "layout"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"const": "text"},
        "content": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 0},
        "layout": {"$ref": "#/$defs/layout"},
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "16:9": {"$ref": "#/$defs/layout"},
            "9:16": {"$ref": "#/$defs/layout"},
            "1:1": {"$ref": "#/$defs/layout"}
          }
        }
      }
    }
  }
}
