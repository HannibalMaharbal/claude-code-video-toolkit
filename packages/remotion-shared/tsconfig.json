{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "react/jsx-runtime.js": ["../../node_modules/@types/react/jsx-runtime.d.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "react"],
    "noEmit": true
  },
  "include": ["src/**/*", "../../types/**/*.d.ts"]
}
